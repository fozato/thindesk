# Copie este arquivo para .env (que NAO vai para o Git) ou configure as variaveis
# no Run Configuration do IntelliJ / no painel do servico de deploy.

# URI de conexao do MongoDB Atlas (obrigatoria)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco (opcional, padrao: thindesk)
# Use um banco separado no desenvolvimento para nao misturar com o app publicado
MONGODB_DATABASE=thindesk_dev

# Cache de templates (opcional, padrao: false; use true em producao)
THYMELEAF_CACHE=false

# Porta HTTP (opcional, padrao: 8080; o Render define automaticamente)
PORT=8080
